    def promedio(self):
        if self.esta_vacia():
            print("Lista vacia: Imposible calcular promedio de temperatura")
            return None

        suma=0
        actual = self.cabeza
        while actual:
            suma+= actual.valor
            actual = actual.siguiente

        return suma / self.tamano

    def temperatura_Mayor(self):
        if self.esta_vacia():
            print("Lista Vacia: Imposible determinar la temperatura mayor resgistrada.")
            return None

        mayor = self.cabeza.valor
        actual = self.cabeza.siguiente

        while actual:
            if actual.valor > mayor:
                mayor = actual.valor
            actual = actual.siguiente

        return mayor

    def temperatura_menor(self):
        if self.esta_vacia():
            print("Lista vacia: Imposible determinar la temperatura menor registrada.")
            return None

        menor = self.cabeza.valor
        actual = self.cabeza.siguiente

        while actual:
            if actual.valor < menor:
                menor = actual.valor
            actual= actual.siguiente

        return menor


