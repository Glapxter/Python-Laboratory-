import random
def bubble_sort(lista):
    
    for i in range(len(lista)):
        for j in range(len(lista)-1):
            if lista[j] > lista[j+1]:
                temp = lista[j]
                lista [j] = lista[j+1]
                lista [j+1] = temp
    return lista   

datos = [random.randint(1, 100) for _ in range(20)]
lista = datos.copy()




print("Lista original:")
print(datos)
print("Lista ordenada")
print(bubble_sort(lista))
